{
  "name": "boilerplate",
  "version": "1.0.1",
  "license": "Private",
  "private": true,
  "repository": "https://github.com/example/app",
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "prepg": "if [ ! -f data/pg/PG_VERSION ]; then mkdir -p data/pg; initdb -U postgres -D data/pg; fi",
    "pg": "trap 'kill 0' SIGINT; postgres -D data/pg --config-file=pg.conf",
    "redis": "echo \"dir data\nbind 127.0.0.1\nport ${REDIS_PORT:-6379}\" | redis-server data -",
    "next": "NODE_OPTIONS='--inspect --max-old-space-size=3536 --enable-source-maps' GIT_TAGS=$(git describe --always --tags --dirty=-dev) dotenv -e ${ENV:-.env.development} -- node server.js",
    "predev": "rm -Rf .next && test -f .nvmrc && command -v nvm && source $HOME/.nvm/nvm.sh && nvm use || true",
    "mail": "source .env.development; mailpit -s 127.0.0.1:${SMTP_PORT:-1026} -l 127.0.0.1:${MAILPIT_HTTP_PORT:-8026} --smtp-auth-allow-insecure --smtp-auth-accept-any",
    "dev": "concurrently -k -s all --names \"pg,redis,next,mail\" \"npm run pg\" \"npm run redis\" \"npm run next\" \"npm run mail\"",
    "build": "NODE_OPTIONS=\"--max-old-space-size=${NEXT_BUILD_MEMORY:-3536}\" next build",
    "start": "NODE_ENV=production NODE_OPTIONS='--max-old-space-size=3536' node --enable-source-maps --inspect=127.0.0.1:9229 server.js",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "postinstall": "if [ -f prisma/schema.prisma ]; then prisma generate --no-hints; fi",
    "premigrate": "if [ ! -f data/pg/postmaster.pid ]; then echo \"Error: PostgreSQL not running, run 'npm run pg' in another terminal\"; exit 1; fi",
    "migrate": "dotenv -e .env.development -- prisma migrate dev",
    "migrate:reset": "dotenv -e .env.development -- prisma migrate reset",
    "redis:kill": "PID=$(lsof -i tcp:6379  | awk '/LISTEN/{print $2}'); if [ \"$PID\" != \"\" ]; then echo \"Killing Redis $PID\"; kill $PID || true; fi",
    "minio:kill": "PID=$(lsof -i tcp:9000  | awk '/LISTEN/{print $2}'); if [ \"$PID\" != \"\" ]; then echo \"Killing Minio $PID\"; kill $PID || true; fi",
    "pg:kill": "PID=$(lsof -i tcp:5432  | awk '/LISTEN/{print $2}'); if [ \"$PID\" != \"\" ]; then echo \"Killing PostgreSQL $PID\"; kill $PID || true; fi",
    "next:kill": "PID=$(lsof -i tcp:3000  | awk '/LISTEN/{print $2}'); if [ \"$PID\" != \"\" ]; then echo \"Killing Next.js $PID\"; kill $PID || true; fi",
    "kill": "npm run redis:kill && npm run minio:kill && npm run pg:kill && npm run next:kill",
    "prerelease": "git diff-files --quiet; if [[ $? -gt 0 ]]; then echo \"FATAL: Uncommitted changes\"; exit 1; fi; BRANCH=$(git branch --show-current); git diff --quiet $BRANCH origin/$BRANCH; if [[ $? -gt 0 ]]; then echo \"FATAL: Branch is not up to date\"; exit 1; fi",
    "release": "npm run lint && npm run test && commit-and-tag-version -r patch && git push && git push --tags",
    "prepare": "husky"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1085.0",
    "@aws-sdk/client-sqs": "^3.1085.0",
    "@aws-sdk/lib-storage": "^3.1085.0",
    "@aws-sdk/s3-request-presigner": "^3.1085.0",
    "@headlessui/react": "^2.2.10",
    "@hookform/resolvers": "^3.10.0",
    "@isomorphic-git/lightning-fs": "^4.6.2",
    "@monaco-editor/react": "^4.7.0",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@octokit/auth-app": "^8.2.0",
    "@octokit/rest": "^21.1.1",
    "@opentelemetry/api-logs": "^0.218.0",
    "@opentelemetry/exporter-logs-otlp-proto": "^0.218.0",
    "@opentelemetry/resources": "^2.9.0",
    "@opentelemetry/sdk-logs": "^0.218.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@radix-ui/react-accordion": "^1.2.16",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-avatar": "^1.2.2",
    "@radix-ui/react-checkbox": "^1.3.7",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-label": "^2.1.11",
    "@radix-ui/react-navigation-menu": "^1.2.18",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-progress": "^1.1.12",
    "@radix-ui/react-scroll-area": "^1.2.14",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-separator": "^1.1.11",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-switch": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.17",
    "@radix-ui/react-toast": "^1.2.19",
    "@radix-ui/react-toggle": "^1.1.14",
    "@radix-ui/react-toggle-group": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@react-email/components": "^0.0.36",
    "@react-email/render": "^1.4.0",
    "@stripe/stripe-js": "^8.11.0",
    "@tailwindcss/postcss": "^4.3.2",
    "@vercel/og": "^0.8.6",
    "ace-builds": "^1.44.0",
    "bullmq": "^5.80.2",
    "chalk": "^5.6.2",
    "chance": "^1.1.13",
    "class-variance-authority": "^0.7.1",
    "classnames": "^2.5.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^3.6.0",
    "framer-motion": "^12.42.2",
    "ioredis": "^5.11.1",
    "isomorphic-git": "^1.38.7",
    "json5": "^2.2.3",
    "jsonrepair": "^3.15.0",
    "jsonschema": "^1.5.0",
    "lightningcss": "^1.32.0",
    "lucide-react": "^0.513.0",
    "markdown-to-jsx": "^7.7.17",
    "mime-types": "^3.0.2",
    "motion": "^12.42.2",
    "ms": "^2.1.3",
    "nanoid": "^5.1.16",
    "next": "^16.2.10",
    "next-auth": "^4.24.14",
    "next-themes": "^0.4.6",
    "nodemailer": "^7.0.13",
    "openai": "^4.104.0",
    "randombytes": "^2.1.0",
    "react": "19.2.4",
    "react-day-picker": "^8.10.2",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.81.0",
    "react-intersection-observer": "^9.16.0",
    "react-is": "19.2.4",
    "react-responsive": "^10.0.1",
    "recharts": "^2.15.4",
    "sass": "^1.101.0",
    "sonner": "^2.0.7",
    "source-map-support": "^0.5.21",
    "stripe": "^19.3.1",
    "swr": "^2.4.2",
    "tail": "^2.2.6",
    "tailwind-merge": "^2.6.1",
    "tailwindcss-animate": "^1.0.7",
    "testcontainers": "^10.28.0",
    "validator": "^13.15.35",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/typography": "^0.5.20",
    "@types/chance": "^1.1.8",
    "@types/eslint": "^9.6.1",
    "@types/mime-types": "^3.0.1",
    "@types/ms": "^0.7.34",
    "@types/node": "^22.20.1",
    "@types/node-forge": "^1.3.14",
    "@types/node-ssh": "^7.0.6",
    "@types/nodemailer": "^6.4.24",
    "@types/randombytes": "^2.0.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/source-map-support": "^0.5.10",
    "@types/sshpk": "^1.17.5",
    "@types/tail": "^2.2.3",
    "@types/validator": "^13.15.10",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "autoprefixer": "^10.5.2",
    "commit-and-tag-version": "^12.7.3",
    "concurrently": "^9.2.4",
    "dotenv-cli": "^8.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.7.0",
    "eslint-config-next": "^16.2.10",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-local-rules": "^3.0.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "glob": "10.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "nodemon": "^3.1.14",
    "postcss": "^8.5.17",
    "prettier": "^3.9.5",
    "prisma": "^7.8.0",
    "prisma-json-types-generator": "^5.1.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.9.3",
    "typescript-json-schema": "^0.65.1",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10",
    "webpack-cli": "^5.1.4"
  },
  "overrides": {
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-is": "19.2.4",
    "glob": "10.5.0",
    "prisma": "$prisma",
    "prisma-json-types-generator": "$prisma-json-types-generator",
    "react-day-picker": {
      "react": "$react",
      "react-dom": "$react-dom"
    },
    "eslint-plugin-react": {
      "eslint": "$eslint"
    },
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    },
    "eslint-plugin-import": {
      "eslint": "$eslint"
    }
  },
  "prettier": {
    "arrowParens": "avoid",
    "bracketSpacing": true,
    "endOfLine": "auto",
    "htmlWhitespaceSensitivity": "css",
    "insertPragma": false,
    "jsxBracketSameLine": false,
    "jsxSingleQuote": false,
    "printWidth": 95,
    "proseWrap": "preserve",
    "quoteProps": "as-needed",
    "requirePragma": false,
    "semi": true,
    "singleQuote": false,
    "tabWidth": 2,
    "trailingComma": "none",
    "useTabs": false,
    "vueIndentScriptAndStyle": true
  },
  "lint-staged": {
    "*.ts": [
      "prettier --write",
      "eslint"
    ],
    "*.tsx": [
      "prettier --write",
      "eslint"
    ],
    "*.scss": [
      "prettier --write"
    ],
    "*.json": [
      "prettier --write"
    ]
  }
}
