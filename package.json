{
  "name": "boilerplate",
  "version": "1.0.1",
  "license": "Private",
  "private": true,
  "repository": "https://github.com/example/app",
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "prepg": "if [ ! -f data/pg/PG_VERSION ]; then mkdir -p data/pg; initdb -D data/pg; fi",
    "pg": "trap 'kill 0' SIGINT; postgres -D data/pg --config-file=pg.conf",
    "preminio": "if [ ! -d data/s3 ]; then mkdir -p data/s3/$USER; fi",
    "minio": "trap 'kill 0' SIGINT; source .env.development; MINIO_ROOT_USER=DEV_ACCESS_KEY_ID MINIO_ROOT_PASSWORD=DEV_SECRET_ACCESS_KEY minio server --address 127.0.0.1:${MINIO_PORT:-9000} --console-address 127.0.0.1:${MINIO_CONSOLE_PORT:-9001} data/s3",
    "redis": "echo \"dir data\nbind 127.0.0.1\nport ${REDIS_PORT:-6379}\" | redis-server data -",
    "next": "NODE_OPTIONS='--inspect --max-old-space-size=3500 --enable-source-maps' GIT_TAGS=$(git describe --always --tags --dirty=-dev) dotenv -e ${ENV:-.env.development} -- node server.js",
    "predev": "rm -Rf .next && if [ -f .nvmrc ]; then source $HOME/.nvm/nvm.sh; nvm use; fi",
    "mail": "source .env.development; mailpit -s 127.0.0.1:${SMTP_PORT:-1026} -l 127.0.0.1:${MAILPIT_HTTP_PORT:-8026} --smtp-auth-allow-insecure --smtp-auth-accept-any",
    "dev": "concurrently -k -s all --names \"pg,s3,redis,next,mail\" \"npm run pg\" \"npm run minio\" \"npm run redis\" \"npm run next\" \"npm run mail\"",
    "build": "next build",
    "start": "NODE_ENV=production NODE_OPTIONS='--max-old-space-size=3536' node server.js",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "postinstall": "if [ ! -d node_modules/.prisma/client ] && [ -f prisma/schema.prisma ]; then prisma generate || true; fi",
    "migrate": "if [ -f data/pg/postmaster.pid ]; then npm run db:migrate:dev; else echo \"Error: PostgreSQL not running\"; exit 1; fi",
    "db:migrate:dev": "dotenv -e .env.development prisma migrate dev",
    "prepare": "husky"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.826.0",
    "@aws-sdk/client-sqs": "^3.826.0",
    "@aws-sdk/lib-storage": "^3.826.0",
    "@aws-sdk/s3-request-presigner": "^3.826.0",
    "@headlessui/react": "^2.2.4",
    "@hookform/resolvers": "^3.10.0",
    "@isomorphic-git/lightning-fs": "^4.6.2",
    "@monaco-editor/react": "^4.7.0",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@octokit/auth-app": "^7.2.1",
    "@octokit/rest": "^21.1.1",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-navigation-menu": "^1.2.13",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toast": "^1.2.14",
    "@radix-ui/react-toggle": "^1.1.9",
    "@radix-ui/react-toggle-group": "^1.1.10",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@react-email/components": "^0.0.36",
    "@react-email/render": "^1.1.2",
    "@stripe/stripe-js": "^8.6.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@vercel/og": "^0.8.6",
    "ace-builds": "^1.42.0",
    "bullmq": "^5.66.2",
    "chance": "^1.1.13",
    "class-variance-authority": "^0.7.1",
    "classnames": "^2.5.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^3.6.0",
    "framer-motion": "^11.18.2",
    "ioredis": "^5.8.2",
    "isomorphic-git": "^1.30.2",
    "js-yaml": "^4.1.1",
    "json5": "^2.2.3",
