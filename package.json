    "jsonschema": "^1.5.0",
    "jspdf-autotable": "^5.0.2",
    "lightningcss": "^1.30.2",
    "lucide-react": "^0.513.0",
    "markdown-to-jsx": "^7.7.6",
    "memfs": "^4.17.2",
    "mime-types": "^3.0.2",
    "minimatch": "^10.0.1",
    "motion": "^12.16.0",
    "nanoid": "^5.1.5",
    "next": "^15.5.9",
    "next-auth": "^4.24.13",
    "next-themes": "^0.4.6",
    "nodemailer": "^7.0.11",
    "openai": "^4.104.0",
    "prisma": "^5.22.0",
    "prisma-field-encryption": "^1.6.0",
    "randombytes": "^2.1.0",
    "react": "19.2.3",
    "react-day-picker": "^8.10.1",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.57.0",
    "react-intersection-observer": "^9.16.0",
    "react-is": "19.2.3",
    "react-responsive": "^10.0.1",
    "recharts": "^2.15.3",
    "sass": "^1.89.1",
    "sonner": "^2.0.5",
    "stripe": "^15.12.0",
    "survey-analytics": "^2.1.1",
    "survey-core": "^2.1.1",
    "survey-creator-core": "^2.1.1",
    "survey-creator-react": "^2.1.1",
    "survey-pdf": "^2.1.1",
    "survey-react-ui": "^2.1.1",
    "swr": "^2.3.3",
    "tail": "^2.2.6",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "testcontainers": "^10.28.0",
    "url-loader": "^4.1.1",
    "zod": "^3.25.56"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^2.13.0",
    "@svgr/webpack": "8.1.0",
    "@tailwindcss/typography": "^0.5.16",
    "@types/chance": "^1.1.6",
    "@types/eslint": "^8.56.12",
    "@types/js-yaml": "4.0.9",
    "@types/mime-types": "^3.0.1",
    "@types/ms": "^0.7.34",
    "@types/node": "^22.15.30",
    "@types/node-forge": "^1.3.11",
    "@types/node-ssh": "^7.0.6",
    "@types/nodemailer": "^6.4.17",
    "@types/randombytes": "^2.0.3",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/sshpk": "^1.17.4",
    "@types/tail": "^2.2.3",
    "@typescript-eslint/eslint-plugin": "^8.33.1",
    "@typescript-eslint/parser": "^8.33.1",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "dotenv-cli": "^8.0.0",
    "esbuild": "^0.25.5",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.9",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-local-rules": "^3.0.2",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-unused-imports": "^4.3.0",
    "husky": "^9.1.7",
    "js-yaml-loader": "^1.2.2",
    "lint-staged": "^15.5.2",
    "nodemon": "^3.1.10",
    "postcss": "^8.5.4",
    "prettier": "^3.5.3",
    "prisma-json-types-generator": "^3.4.2",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.8.3",
    "typescript-json-schema": "^0.65.1",
    "vite-tsconfig-paths": "^6.0.3",
    "vitest": "^4.0.16",
    "webpack-cli": "^5.1.4"
  },
  "overrides": {
    "react": "$react",
    "react-dom": "$react-dom",
    "react-is": "$react-is",
    "prisma": "$prisma",
    "prisma-json-types-generator": "$prisma-json-types-generator",
    "eslint-plugin-react-hooks": "$eslint-plugin-react-hooks",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3"
  },
  "prettier": {
    "arrowParens": "avoid",
    "bracketSpacing": true,
    "endOfLine": "auto",
    "htmlWhitespaceSensitivity": "css",
    "insertPragma": false,
    "jsxBracketSameLine": false,
    "jsxSingleQuote": false,
    "printWidth": 95,
    "proseWrap": "preserve",
    "quoteProps": "as-needed",
    "requirePragma": false,
    "semi": true,
    "singleQuote": false,
    "tabWidth": 2,
    "trailingComma": "none",
    "useTabs": false,
    "vueIndentScriptAndStyle": true
  },
  "lint-staged": {
    "*.ts": [
      "prettier --write",
      "eslint"
    ],
    "*.tsx": [
      "prettier --write",
      "eslint"
    ],
    "*.scss": [
      "prettier --write"
    ],
    "*.json": [
      "prettier --write"
    ]
  }
}
