# =============================================================================
# NEXTAUTH CONFIGURATION
# =============================================================================
# Generate a secure secret with: openssl rand -base64 32
NEXTAUTH_SECRET=osee1YaiquohfuMeehoewahn

# Application URLs (update for production)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# OAuth Providers (uncomment and configure as needed)
#GOOGLE_CLIENT_ID=your-google-client-id
#GOOGLE_CLIENT_SECRET=your-google-client-secret

# Authentication Methods (set to 1 to enable)
#NEXTAUTH_CREDENTIALS=1  # Enable username/password auth
NEXTAUTH_EMAIL=1          # Enable email magic link auth

# =============================================================================
# SMTP CONFIGURATION (for sending emails)
# =============================================================================
# For local development, these settings work with MailHog (npm run mail)
# For production, use your email provider's SMTP settings
SMTP_HOST=127.0.0.1
SMTP_PORT=1225
# SMTP_USER=your-smtp-username
# SMTP_PASS=your-smtp-password
SMTP_SECURE=0  # Set to 1 for TLS/SSL (port 465), 0 for STARTTLS (port 587) or no encryption

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# PostgreSQL connection string
# Format: postgres://username:password@host:port/database
DATABASE_URL=postgres://ruslan:@localhost:5433/postgres

# Database field encryption key
# Generate a new key at: https://cloak.47ng.com/
DATABASE_ENCRYPTION_KEY=k1.aesgcm256.5VGKBnJxrh30BUzmyaLS4MxttThZUenc38aF2TePNgM=

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
# Redis connection string for caching and queue system
REDIS_URL=redis://localhost:6379

# =============================================================================
# S3 STORAGE CONFIGURATION
# =============================================================================
# For local development, these settings work with MinIO (npm run minio)
# For production, use your AWS S3 or S3-compatible service credentials
S3_REGION=eu-central-1
S3_ACCESS_KEY_ID=DEV_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=DEV_SECRET_ACCESS_KEY
S3_BUCKET=$USER
S3_PREFIX=test
S3_ENDPOINT=http://127.0.0.1:9000  # Remove or comment out for AWS S3
S3_DOWNLOAD_PRESIGNED=0  # Set to 1 to use presigned URLs for downloads

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
# Your application details (update these for your project)
NEXT_PUBLIC_APP_NAME=Example
NEXT_PUBLIC_APP_DESCRIPTION=Example description
NEXT_PUBLIC_MAIL_FROM=hello@example.com
NEXT_PUBLIC_YEAR=2025
NEXT_PUBLIC_CREDENTIALS_DOMAIN=wizecore.com

# =============================================================================
# ANALYTICS & MONITORING (optional)
# =============================================================================
# Plausible Analytics configuration (if using)
NEXT_PUBLIC_PLAUSIBLE_SCRIPT_URL=https://plausible.io/js/script.js

# =============================================================================
# LOGGING & DEBUGGING
# =============================================================================
# Set to 1 to enable verbose logging
NEXT_PUBLIC_LOG_VERBOSE=0
SERVER_LOG_IP_ADDRESS=0
