#
# Copy this file to .env.development
#
#
# =============================================================================
# NEXTAUTH CONFIGURATION
# =============================================================================
# Generate your secure secret with: openssl rand -base64 32
NEXTAUTH_SECRET=osee1YaiquohfuMeehoewahn

# Application URLs (update for production)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# OAuth Providers (uncomment and configure as needed)
#GOOGLE_CLIENT_ID=your-google-client-id
#GOOGLE_CLIENT_SECRET=your-google-client-secret

# Authentication Methods (set to 1 to enable)

# Enable username/password auth
NEXTAUTH_CREDENTIALS=1

# Enable email magic link auth
# NEXTAUTH_EMAIL=1

# =============================================================================
# SMTP CONFIGURATION (for sending emails)
# =============================================================================
# For local development, these settings work with MailHog (npm run mail)
# For production, use your email provider's SMTP settings
SMTP_HOST=127.0.0.1
SMTP_PORT=1026
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_SECURE=0  # Set to 1 for TLS/SSL (port 465), 0 for STARTTLS (port 587) or no encryption

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# PostgreSQL connection string
# Format: postgres://username:password@host:port/database
DATABASE_URL=postgres://postgres:@localhost:5433/postgres

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
# Redis connection string for caching and queue system
REDIS_URL=redis://localhost:6379

# =============================================================================
# S3 STORAGE CONFIGURATION
# =============================================================================
# For local development, these settings work with MinIO (npm run minio)
# For production, use your AWS S3 or S3-compatible service credentials
S3_REGION=eu-central-1
S3_ACCESS_KEY_ID=DEV_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=DEV_SECRET_ACCESS_KEY
S3_BUCKET=$USER
 # Remove or comment out for AWS S3
S3_ENDPOINT=http://127.0.0.1:9000
# Set to 1 to use presigned URLs for downloads, not supported by minio
S3_DOWNLOAD_PRESIGNED=0
# Set to 1 to use presigned URLs for uploads, not supported by minio
S3_UPLOAD_PRESIGNED=0

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
# Your application details (update these for your project)
NEXT_PUBLIC_APP_NAME=Example
NEXT_PUBLIC_APP_DESCRIPTION=Example description
NEXT_PUBLIC_MAIL_FROM=hello@example.com
NEXT_PUBLIC_YEAR=2025

# Domain for local test login
NEXT_PUBLIC_CREDENTIALS_DOMAIN=wizecore.com

# =============================================================================
# ANALYTICS & MONITORING (optional)
# =============================================================================
# Plausible Analytics configuration (if using)
# NEXT_PUBLIC_PLAUSIBLE_SCRIPT_URL=https://plausible.io/js/script.js

# =============================================================================
# LOGGING & DEBUGGING
# =============================================================================
# Set to 1 to enable verbose logging
NEXT_PUBLIC_LOG_VERBOSE=0

# Write IP address to the log
SERVER_LOG_IP_ADDRESS=0

# Tag every logger.info()/logger.warn() with a per-request requestId (async
# request tracker in tools/request-tracker.js). Also enabled automatically when
# OPENTELEMETRY_LOGS_ENABLED=1.
LOG_REQUEST_TRACKER=0

# =============================================================================
# SERVER TUNING (custom server in server.js; all optional)
# =============================================================================
# HTTP keep-alive timeout in milliseconds
# KEEP_ALIVE_TIMEOUT=60000
# Server request timeout in milliseconds (including uploads)
# SERVER_REQUEST_TIMEOUT=600000
# Set TCP_NODELAY on the request socket (set to 1 to enable)
# SERVER_SOCKET_NODELAY=0
# Per-socket timeout in milliseconds (leave unset to disable)
# SERVER_SOCKET_TIMEOUT=
# Graceful shutdown timeout in milliseconds (drains connections and tasks)
SERVER_SHUTDOWN_TIMEOUT=60000
# Reuse port to allow multiple instances to bind the same port (set to 1)
SERVER_REUSE_PORT=0
# Write a pid file (supports the {pid} placeholder), removed on graceful shutdown
# SERVER_PID_FILE=
# Set to 1 when the queue is processed by a separate standalone process
QUEUE_STANDALONE=0

# =============================================================================
# OPENTELEMETRY LOGS (optional log shipping via tools/log-collector.js)
# =============================================================================
# Ships every logger call to an OTLP logs endpoint (e.g. VictoriaLogs) using the
# @opentelemetry/* packages. Disabled by default; enabling only requires the env
# vars below (the packages are already in package.json).
# Set to 1 to install the log collector
OPENTELEMETRY_LOGS_ENABLED=0
# OTLP logs endpoint URL (protobuf encoding)
OPENTELEMETRY_LOGS_URL=
# Optional basic-auth credentials for the logs endpoint
# OPENTELEMETRY_LOGS_USERNAME=
# OPENTELEMETRY_LOGS_PASSWORD=
# Optional bearer token for the logs endpoint (takes precedence over basic auth)
# OPENTELEMETRY_LOGS_TOKEN=
# Set to 0 to stop also mirroring collected logs to the console
OPENTELEMETRY_LOGS_CONSOLE=1
# Optional service name/version reported with each log record
# OPENTELEMETRY_LOGS_SERVICE_NAME=app
# OPENTELEMETRY_LOGS_SERVICE_VERSION=
